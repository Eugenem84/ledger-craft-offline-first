{
  "name": "ledger-craft",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "ledger-craft",
  "author": "Eugene Medov",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{js,cjs,mjs,vue}\" \"./test/**/*.js\" \"./vitest.config.js\"",
    "format": "prettier --write \"**/*.{js,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "quasar dev",
    "build": "quasar build",
    "release:android": "bash scripts/release-apk.sh",
    "release:web": "bash scripts/release-web.sh",
    "feedback:pull": "node scripts/pull-feedback.mjs",
    "landing:serve": "node scripts/serve-landing.mjs",
    "landing:publish": "bash scripts/publish-landing.sh",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.3",
    "@capacitor/app": "^7.1.2",
    "@capacitor/browser": "^7.0.5",
    "@capacitor/core": "^7.6.9",
    "@capacitor/filesystem": "^7.1.8",
    "@capawesome/capacitor-live-update": "^7.5.0",
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "jeep-sqlite": "^2.8.0",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "sql.js": "^1.13.0",
    "uuid": "^13.0.0",
    "vue": "^3.5.22",
    "vue-router": "^4.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.9",
    "@capacitor/cli": "^7.6.9",
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.1.0",
    "@vue/eslint-config-prettier": "^10.1.0",
    "autoprefixer": "^10.4.2",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.4.0",
    "globals": "^16.4.0",
    "postcss": "^8.4.14",
    "prettier": "^3.3.3",
    "vite-plugin-checker": "^0.11.0",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.2.0"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
