<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <!-- Клавиатура и edge-to-edge (задача 14.30, живой отчёт 12.10.2026).
             На Android 15 (`targetSdk 35`) окно разложено во весь экран, а Capacitor в режиме
             `adjustMarginsForEdgeToEdge: "auto"` раздаёт отступы только системных панелей —
             инсет клавиатуры не учитывается, и она перекрывала поля ввода (вход, регистрация,
             «комментарии» в заказе). Отступ под клавиатуру применяет наш слушатель инсетов
             в `MainActivity.applyKeyboardInsets()`; `adjustResize` здесь нужен, чтобы система
             сообщала инсет IME и не «панорамировала» окно вместо этого. -->

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ссылки из писем → приложение (подтверждение почты и сброс пароля).
                 Веб-версии приложения нет, поэтому письма ведут на https-bridge
                 бэкенда, а он открывает приложение. Две дороги:

                   1) Android App Links (https + autoVerify): если домен верифицирован
                      через `public/.well-known/assetlinks.json` (отпечаток ключа
                      подписи), Android открывает приложение прямо по https-ссылке из
                      письма, без браузера. Верификация — по каждому host отдельно,
                      поэтому здесь два host'а: dev (`ledgercraft.dev.medovf2h.beget.tech`)
                      и боевой `ledgercraft.ru` (появился 26.09.2026, задача 11.12).
                   2) Своя схема `ledgercraft://`: фолбэк для debug-сборок и пока
                      верификация домена не прошла — bridge-страница бэкенда
                      (`resources/views/app-link.blade.php`) уводит сюда.

                 Обе ссылки разбирает `src/boot/deepLinks.js` (см. `src/domain/deepLinks.js`). -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ledgercraft.dev.medovf2h.beget.tech"
                    android:pathPrefix="/app" />
            </intent-filter>

            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="ledgercraft.ru"
                    android:pathPrefix="/app" />
            </intent-filter>

            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="ledgercraft" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Результат установки APK (Фаза 13, задача 13.11): запускает системный
             диалог подтверждения и отдаёт итог установки в JS (`installResult`). -->
        <receiver
            android:name=".InstallResultReceiver"
            android:exported="false" />
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Обновление приложения (Фаза 13, задача 13.11): без этого разрешения Android
         не покажет диалог установки скачанного APK. Само разрешение пользователь
         выдаёт в системных настройках («Установка неизвестных приложений») — в
         приложении за это отвечает `ApkInstallerPlugin.openSettings()`. Скачивание
         идёт по https с сервера мастерской, подпись APK проверяется тем же ключом. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
</manifest>
