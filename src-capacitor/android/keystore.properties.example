# Шаблон подписи Android-сборки (Фаза 13, задача 13.3).
#
# Скопируйте файл в `src-capacitor/android/keystore.properties` и заполните —
# он в .gitignore и в репозиторий не попадает.
#
# Ключ создаётся ОДИН РАЗ (и хранится в двух местах — облако/флешка):
#
#   mkdir -p ~/keystores
#   keytool -genkeypair -v \
#     -keystore ~/keystores/ledger-craft.keystore \
#     -alias ledger-craft -keyalg RSA -keysize 2048 -validity 10950 \
#     -storepass '<пароль>' -keypass '<пароль>' \
#     -dname "CN=Ledger Craft, OU=Mobile, O=Ledger Craft, C=RU"
#
# ⚠️ Потеря ключа = невозможно обновить уже установленные приложения:
#    Android ставит обновление только при совпадении подписи.
#
# storeFile: абсолютный путь или путь относительно `src-capacitor/android`.

storeFile=/Users/<вы>/keystores/ledger-craft.keystore
storePassword=change-me
keyAlias=ledger-craft
keyPassword=change-me
