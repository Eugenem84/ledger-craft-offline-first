# Конфигурация клиента (задача 7.1).
#
# Этот файл отслеживается git'ом: здесь безопасные дефолты сборки.
# Локальные переопределения кладите в `.env.local` (он в .gitignore), например:
#   VITE_API_URL=http://localhost:8000/api
#
# Quasar CLI подмешивает `.env`/`.env.local` в любом режиме (dev/prod/capacitor),
# поэтому адрес сервера меняется без правки кода — см. `src/config.js`.

VITE_API_URL=https://dev.medovf2h.beget.tech/api

# Моки сетевого слоя (задача 7.2): учитываются только в dev-сборке, в проде — игнор.
VITE_USE_MOCK=false

# Обратная связь (Фаза 14): токен выгрузки отчётов «Сообщить об ошибке» для
# `npm run feedback:pull` (тот же токен, что FEEDBACK_PULL_TOKEN на сервере).
# Здесь пусто осознанно: реальный токен кладите в `.env.local` (он в .gitignore) —
# тогда выгрузка работает, а токена нет в репозитории.
FEEDBACK_PULL_TOKEN=
